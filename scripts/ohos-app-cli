#!/usr/bin/env bash
# Production CLI Bridge (`ohos-app-cli`) invoking `telegram_ohos_cli` (`TelegramCoreEngine`).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
source "${SCRIPT_DIR}/env.sh"

TARGET_DIR="${CARGO_TARGET_DIR:-${REPO_ROOT}/target}"
BIN_PATH="${TARGET_DIR}/release/telegram_ohos_cli"
if [[ ! -x "${BIN_PATH}" ]]; then
  flock -x /home/antigravity/toolchains/build.lock \
    cargo build --manifest-path "${REPO_ROOT}/Cargo.toml" --release -p telegram_ohos_napi --bin telegram_ohos_cli >&2
fi

exec "${BIN_PATH}" "$@"
